{
  "name": "image-in-place",
  "private": true,
  "version": "0.1.0",
  "description": "Editor de imágenes privado que funciona en el navegador, pensado para docentes.",
  "homepage": "https://imageinplace.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4180",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/run.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "exifr": "^7.1.3",
    "jszip": "^3.10.2",
    "libheif-js": "^1.23.5",
    "lucide-react": "^1.66.0",
    "onnxruntime-web": "^1.31.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tesseract.js-data/cat": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/eus": "^1.0.0",
    "@tesseract.js-data/glg": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "playwright": "^1.64.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
